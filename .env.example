# Copy to .env for local (non-Docker) runs. docker-compose.yml sets its own values.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://medflow.example.com

# Unset = SQLite fallback (db.sqlite3). With `docker compose up db redis`:
# DATABASE_URL=postgres://medflow:medflow@localhost:5432/medflow

# Celery. Set CELERY_TASK_ALWAYS_EAGER=True to run tasks inline without Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=True
APPOINTMENT_REMINDER_LEAD_HOURS=24

# Email (console backend prints messages to stdout)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=MedFlow <no-reply@medflow.local>

# JWT lifetimes
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
